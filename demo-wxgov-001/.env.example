# =============================================================================
# DEMO-WXGOV-001 — AI Governance + AgentOps Demo
# Built with IBM watsonx
# DEPLOY_TARGET: local
# BUILD_ARCH: arm64
# =============================================================================
# NEVER commit a filled .env file. This is a template only.
# Copy to .env and fill in real values when running in LIVE mode.

# --------------- DEMO MODE ---------------
DEMO_MODE=mock
# Set to "live" to use real IBM services

# --------------- FRONTEND ---------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEMO_TITLE="AI Governance + AgentOps — Built with IBM watsonx"
VITE_DEMO_CLIENT_CODE=DEMO-WXGOV-001

# --------------- watsonx.ai ---------------
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=meta-llama/llama-4-maverick-17b-128e-instruct-fp8

# --------------- watsonx Orchestrate ---------------
# ADK CLI auth
WXO_ENV_URL=https://api.us-south.watson-orchestrate.cloud.ibm.com/instances/YOUR_INSTANCE_ID
IBM_CLOUD_API_KEY=

# Frontend embed (Hybrid Carbon shell)
# Agent ID confirmed from: orchestrate agents list (deployed 2026-11-17)
VITE_WXO_HOST_URL=https://us-south.watson-orchestrate.cloud.ibm.com
VITE_WXO_ORCHESTRATION_ID=
VITE_WXO_CRN=
VITE_WXO_AGENT_ID=cff37e58-9a7a-40d1-9151-80365b59d8a3
WXO_DEFAULT_MODEL=groq/openai/gpt-oss-120b

# --------------- watsonx.governance ---------------
# (uses same WATSONX_API_KEY + PROJECT_ID as watsonx.ai)
WXG_SPACE_ID=
WXG_MODEL_ID=

# --------------- Instana (AgentOps observability) ---------------
INSTANA_API_URL=
INSTANA_API_TOKEN=

# --------------- OpenTelemetry (agent instrumentation) ---------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# For wxO AgentOps ingest: replace with your wxO instance:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.us-south.watson-orchestrate.cloud.ibm.com/v1/orchestrate/inject/traces
OTEL_SERVICE_NAME=ai-governance-agent
WXO_TENANT_ID=
WXO_ENVIRONMENT_NAME=live

# --------------- Database ---------------
DATABASE_URL=sqlite:///./demo.db
