# Configurações do Servidor
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1
APP_NAME=SistemaReembolsoDespesas
APP_URL=http://localhost:3000

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=reembolso_db
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_MS=30000

# Autenticação e Segurança (JWT)
JWT_SECRET=super_secret_jwt_key_reembolso_despesas_2026_seguro
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_reembolso_2026
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Políticas e Regras de Reembolso
AUTO_APPROVAL_LIMIT=100.00
DIRECTOR_APPROVAL_THRESHOLD=5000.00
VP_APPROVAL_THRESHOLD=20000.00
MAX_EXPENSE_AGE_DAYS=60
DEFAULT_CURRENCY=BRL

# Notificações e Email (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_user
SMTP_PASS=test_pass
SMTP_FROM=nao-responda@reembolsotech.com.br
ENABLE_EMAIL_NOTIFICATIONS=true

# Armazenamento de Arquivos / Comprovantes
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Logging e Auditoria
LOG_LEVEL=debug
LOG_FILE_PATH=logs/app.log
ENABLE_AUDIT_LOG=true
